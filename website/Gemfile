source "https://rubygems.org"

# Local preview and CI build from this file and its lockfile, so both run the
# same Jekyll. .ruby-version records the interpreter they share; raise it and
# the pin in .github/workflows/pages.yml together.
gem "jekyll", "~> 4.3"
gem "minima", "~> 2.5"

# Ruby 3+ dropped webrick from the standard library; `jekyll serve` needs it
# for local preview.
gem "webrick", "~> 1.8"
