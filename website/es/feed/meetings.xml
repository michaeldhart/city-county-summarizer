---
layout: null
permalink: /es/feed/meetings.xml
lang: es
---
{%- comment -%}
  The Spanish wire: one entry per translated dispatch. jekyll-feed only reads
  collections, and the Spanish dispatches are cloned pages (see
  _plugins/i18n.rb), so this is written by hand, like feed/issues.xml. An
  untranslated dispatch has no entry here until its translation exists; the
  English wire carries it meanwhile.
{%- endcomment -%}
{%- assign wire_title = 'feed_wire_title' | t -%}
{%- assign feed_title = site.title | append: " | " | append: wire_title -%}
{%- assign dispatches = site.pages | where: "es_meeting", true | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="es">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/es/beats/' | absolute_url }}" rel="alternate" type="text/html" />
  <title type="html">{{ feed_title | xml_escape }}</title>
  <subtitle>{{ 'site_description' | t | xml_escape }}</subtitle>
  <updated>{% if dispatches.size > 0 %}{{ dispatches[0].date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <author><name>{{ site.author | xml_escape }}</name></author>
  {%- for d in dispatches limit: 50 %}
  <entry>
    <title type="html">{{ d.title | xml_escape }}</title>
    <link href="{{ d.url | absolute_url }}" rel="alternate" type="text/html" />
    <published>{{ d.date | date_to_xmlschema }}</published>
    <updated>{{ d.date | date_to_xmlschema }}</updated>
    <id>{{ d.url | absolute_url | xml_escape }}</id>
    {%- if d.description %}
    <summary type="html">{{ d.description | xml_escape }}</summary>
    {%- endif %}
    <content type="html">{{ d.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
